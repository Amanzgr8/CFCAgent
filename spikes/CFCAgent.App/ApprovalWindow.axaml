<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CFCAgent.App.Core"
        x:Class="CFCAgent.App.ApprovalWindow"
        x:DataType="vm:ApprovalRequestViewModel"
        Title="Approve change"
        Width="560" SizeToContent="Height" MinHeight="220" MaxHeight="620"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="Button.apply">
      <Setter Property="Background" Value="#2D6CDF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.apply:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2459B8" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20,16,20,16" RowSpacing="12">
    <TextBlock Grid.Row="0" Text="The assistant wants to make this change" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

    <!-- The exact preview the server produced, shown unchanged. It scrolls when it is long. -->
    <Border Grid.Row="1" CornerRadius="6" Background="#18808080" Padding="12,10">
      <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
        <SelectableTextBlock x:Name="PreviewText" Text="{Binding Message}" TextWrapping="Wrap"
                             FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="13" />
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="2" Text="Nothing is changed unless you press Apply change. Cancel, Esc and closing this window all leave everything as it is."
               TextWrapping="Wrap" FontSize="12" Opacity="0.7" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <!-- Cancel is the default button, so Enter can only ever cancel. Applying takes a deliberate click. -->
      <Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}" IsDefault="True" IsCancel="True" MinWidth="90" />
      <Button x:Name="ApplyButton" Classes="apply" Content="Apply change" Command="{Binding ApplyCommand}" MinWidth="120" />
    </StackPanel>
  </Grid>
</Window>

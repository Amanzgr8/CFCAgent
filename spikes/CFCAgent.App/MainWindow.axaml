<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CFCAgent.App.Core"
        xmlns:local="using:CFCAgent.App"
        xmlns:mv="using:MarkView.Avalonia"
        x:Class="CFCAgent.App.MainWindow"
        x:DataType="vm:ChatViewModel"
        Title="CFC Agent (spike)"
        Width="900" Height="640" MinWidth="480" MinHeight="360">

  <Window.Styles>
    <!-- Message bubbles. Colours are semi-transparent or fixed so they read on both light and dark themes. -->
    <Style Selector="Border.bubble">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="MaxWidth" Value="680" />
      <Setter Property="Background" Value="#22808080" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.bubble.user">
      <Setter Property="Background" Value="#2D6CDF" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.bubble.user SelectableTextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.bubble.notice">
      <Setter Property="Background" Value="#33D9534F" />
    </Style>
    <!-- The mode badge: neutral grey for read-only, amber when changes are allowed. -->
    <Style Selector="Border.badge">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="#33808080" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge.writes">
      <Setter Property="Background" Value="#F2A93B" />
    </Style>
    <Style Selector="Border.badge.writes TextBlock">
      <Setter Property="Foreground" Value="#2B1B00" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto,Auto">

    <ScrollViewer x:Name="Scroller" Grid.Row="0" Padding="16,16,16,8">
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="10" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChatMessageViewModel">
            <Panel>
              <Border Classes="bubble"
                      Classes.user="{Binding IsUser}"
                      Classes.notice="{Binding IsNotice}"
                      IsVisible="{Binding !IsApproval}">
                <StackPanel Spacing="4">
                  <!-- The user's words and app notices stay plain text; the assistant's reply is Markdown. -->
                  <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding IsPlainText}" />
                  <mv:MarkdownViewer local:MarkdownMessage.Source="{Binding}" IsVisible="{Binding IsAssistant}" />
                  <TextBlock Text="..." Opacity="0.6" IsVisible="{Binding IsStreaming}" />
                </StackPanel>
              </Border>
              <!-- An "apply this change?" question, in the conversation where it was asked. -->
              <ContentControl Content="{Binding Approval}" IsVisible="{Binding IsApproval}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:ApprovalRequestViewModel">
                    <local:ApprovalCard />
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="1" Margin="16,8,16,8" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBox x:Name="InputBox" Grid.Column="0" IsEnabled="{Binding IsConnected}"
               Text="{Binding Input, Mode=TwoWay}"
               AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140"
               PlaceholderText="Ask about ingredients, formulas or customers. Enter sends, Shift+Enter adds a line." />
      <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" VerticalAlignment="Bottom" />
      <Button Grid.Column="2" Content="Stop" Command="{Binding SendCancelCommand}"
              IsVisible="{Binding IsBusy}" VerticalAlignment="Bottom" />
    </Grid>

    <StackPanel Grid.Row="2" Margin="16,0,16,8" Spacing="2">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <!-- Which mode this session is in, always visible: read-only, or changes allowed (amber). -->
        <Border Grid.Column="0" x:Name="ModeBadgeBorder" Classes="badge" Classes.writes="{Binding AllowChanges}"
                IsVisible="{Binding CanSwitchMode}">
          <TextBlock x:Name="ModeBadgeText" Text="{Binding ModeBadge}" FontSize="11" FontWeight="SemiBold" />
        </Border>
        <TextBlock Grid.Column="1" x:Name="StatusLine" Text="{Binding ConnectionStatus}" FontSize="12" Opacity="0.8"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <Button Grid.Column="2" x:Name="ToggleChangesButton" Content="{Binding ToggleChangesLabel}"
                Command="{Binding ToggleChangesCommand}" IsVisible="{Binding CanSwitchMode}" FontSize="12" Padding="8,2" />
        <Button Grid.Column="3" Content="Retry" Command="{Binding RetryConnectionCommand}"
                IsVisible="{Binding !IsConnected}" FontSize="12" Padding="8,2" />
      </Grid>
      <TextBlock Text="{Binding RuntimeInfo}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Grid>
</Window>

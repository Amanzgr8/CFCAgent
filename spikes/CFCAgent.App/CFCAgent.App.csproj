<Project Sdk="Microsoft.NET.Sdk">

  <!-- The thin UI layer: Avalonia windows and controls only. Anything that decides behaviour belongs
       in CFCAgent.App.Core. Plain net10.0 (never a -windows target) so it builds for every desktop OS. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <!-- Markdown for assistant replies. MIT. Picked in spike step 3 (see the bake-off project). -->
    <PackageReference Include="MarkView.Avalonia" Version="12.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CFCAgent.App.Core\CFCAgent.App.Core.csproj" />
    <!-- Build-order only: the app launches the built MCP server as a child process; it does not link to it. -->
    <ProjectReference Include="..\..\src\CFCAgent.McpServer\CFCAgent.McpServer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

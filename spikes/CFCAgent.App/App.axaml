<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CFCAgent.App.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <!-- MarkView: the viewer template, then the compact chat look (small headings, code in cards). -->
    <StyleInclude Source="avares://MarkView.Avalonia/Themes/MarkdownTheme.axaml" />
    <StyleInclude Source="avares://MarkView.Avalonia/Themes/ChatTheme.axaml" />
  </Application.Styles>
</Application>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- View-models and app logic only. No Avalonia (or any UI framework) reference and no
       Windows-specific target, so this layer survives a change of UI framework and runs on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CFCAgent.Backend\CFCAgent.Backend.csproj" />
  </ItemGroup>

</Project>

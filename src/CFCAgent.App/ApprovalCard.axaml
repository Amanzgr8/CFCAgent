<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CFCAgent.App.Core"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="CFCAgent.App.ApprovalCard"
             x:DataType="vm:ApprovalRequestViewModel">

  <UserControl.Styles>
    <!-- Amber while a question is waiting; a quiet card once it has been answered. -->
    <Style Selector="Border.approval">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource CardBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>
    <Style Selector="Border.approval.pending">
      <Setter Property="Padding" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WarnLine}" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #10000000, 0 14 30 -12 #22000000" />
    </Style>
  </UserControl.Styles>

  <Border Classes="approval" Classes.pending="{Binding IsPending}">
    <Panel>
      <!-- Waiting for an answer: the server's exact preview and the two buttons. -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" IsVisible="{Binding IsPending}">
        <Border Width="36" Height="36" CornerRadius="10" VerticalAlignment="Top" Background="{DynamicResource CardBg}">
          <ic:SymbolIcon Symbol="ShieldCheckmark" IconVariant="Filled" FontSize="19" Foreground="{DynamicResource WarnInk}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel x:Name="PendingPanel" Grid.Column="1" Spacing="10">
          <StackPanel Spacing="2">
            <TextBlock Classes="h2" Text="Approve this change?" />
            <TextBlock Classes="muted" Foreground="{DynamicResource WarnInk}" TextWrapping="Wrap"
                       Text="Nothing is changed unless you press Apply change. Cancel, Esc and Enter all leave everything as it is." />
          </StackPanel>

          <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                  CornerRadius="10" Padding="14,10">
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
              <SelectableTextBlock x:Name="PreviewText" Text="{Binding Message}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Ink}"
                                   FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="13" />
            </ScrollViewer>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <!-- Cancel takes the focus when the card appears, so Enter can only ever cancel. Applying takes a deliberate click. -->
            <Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90"
                    HorizontalContentAlignment="Center" CornerRadius="9" Padding="18,8"
                    Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource WarnLine}" BorderThickness="1" />
            <Button x:Name="ApplyButton" Classes="accent" Content="Apply change" Command="{Binding ApplyCommand}"
                    MinWidth="120" HorizontalContentAlignment="Center" CornerRadius="9" Padding="18,8" FontWeight="SemiBold" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Answered: shrinks to a short record that stays in the conversation. -->
      <StackPanel x:Name="RecordPanel" Spacing="2" IsVisible="{Binding !IsPending}">
        <TextBlock x:Name="RecordStatus" Text="{Binding StatusText}" FontSize="13.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource Ink}" />
        <TextBlock x:Name="RecordSummary" Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" />
      </StackPanel>
    </Panel>
  </Border>
</UserControl>

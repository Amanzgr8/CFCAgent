<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the real windows with Avalonia's headless platform (part of the free, MIT framework), so
       a screen can be checked, and saved as an image, without opening a window or a designer.
       Avalonia.Headless.XUnit is built on xunit v3, so this project (unlike the other test projects)
       uses xunit v3, which makes the test project an executable. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CFCAgent.App\CFCAgent.App.csproj" />
  </ItemGroup>

</Project>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CFCAgent.App.Core"
             x:Class="CFCAgent.App.SettingsPanel"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#C0392B" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="24,20,24,16" Spacing="14">

      <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="This install's connection to the CFC database." Opacity="0.75" TextWrapping="Wrap" />

      <StackPanel Spacing="4">
        <TextBlock Classes="fieldLabel" Text="Tenant name" />
        <TextBox x:Name="TenantBox" Text="{Binding TenantName, Mode=TwoWay}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Classes="fieldLabel" Text="Product config (optional)" />
        <TextBox x:Name="ProductConfigBox" Text="{Binding ProductConfigPath, Mode=TwoWay}"
                 PlaceholderText="{Binding DefaultProductConfigPath}" />
        <TextBlock Text="Leave blank to use the product's default config." FontSize="12" Opacity="0.65" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Classes="fieldLabel" Text="Database connection string" />
        <!-- Masked: the dots hide what is typed or pasted. It is never filled in from what is saved. -->
        <TextBox x:Name="SecretBox" PasswordChar="•" Text="{Binding ConnectionString, Mode=TwoWay}"
                 PlaceholderText="{Binding SecretHint}" />
        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap">
          <Run Text="Saved in " /><Run Text="{Binding StoreName}" /><Run Text=", never in a file, and not shown again after you save." />
        </TextBlock>
      </StackPanel>

      <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" Classes.error="{Binding StatusIsError}"
                 TextWrapping="Wrap" MinHeight="20" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="TestButton" Content="Test connection" Command="{Binding TestConnectionCommand}" />
        <Button x:Name="CancelTestButton" Content="Cancel test" Command="{Binding TestConnectionCancelCommand}"
                IsVisible="{Binding IsBusy}" />
        <Button x:Name="SaveButton" Content="Save" Command="{Binding SaveCommand}" />
        <Button x:Name="CloseButton" Content="Close" Command="{Binding CloseCommand}" />
      </StackPanel>

      <TextBlock Text="Saving reconnects the app in read-only mode and starts a new conversation." FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
